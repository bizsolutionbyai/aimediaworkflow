# AI Media Workflow — local configuration.
# Copy this file to .env and fill in only the providers you use. Restart the app after editing.
# Keys stay on this machine: they are never stored in the database, shown in the UI or written to Markdown exports.

# ---- Server ----
PORT=8787
HOST=127.0.0.1
# Data directory (SQLite database, uploaded assets, generated outputs). Relative to the repository root.
DATA_DIR=data
# Markdown exports are written to <EXPORT_DIR>/<project>--<space>/
EXPORT_DIR=exports

# ---- Image / video / voice providers ----
# OpenAI: GPT Image (openai-image), Sora video (openai-sora), TTS (openai-tts), chat assistant (openai-llm)
OPENAI_API_KEY=
# Google: Gemini image (google-image), Veo video (google-veo). GEMINI_API_KEY also works.
GOOGLE_API_KEY=
# xAI Grok image (xai-image). XAI_API_KEY also works.
GROK_API_KEY=
# ElevenLabs voice (elevenlabs). Voice id comes from the voice profile or ELEVENLABS_VOICE_ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- AI Assistant (LLM) ----
ANTHROPIC_API_KEY=

# ---- Optional defaults ----
# Provider used when a node/scene does not choose one (otherwise the first configured provider is used).
DEFAULT_IMAGE_PROVIDER=
DEFAULT_VIDEO_PROVIDER=
DEFAULT_VOICE_PROVIDER=
DEFAULT_LLM_PROVIDER=
# Model overrides: <PROVIDER_ID>_MODEL with dashes as underscores, e.g.
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_SORA_MODEL=sora-2
# ANTHROPIC_MODEL=claude-sonnet-5-5
# OPENAI_LLM_MODEL=gpt-4.1-mini

# ---- Execution ----
# Attempts per job (1 = no retry). Retries only happen for rate limits / server errors / network errors.
JOB_MAX_ATTEMPTS=2
VIDEO_POLL_INTERVAL_MS=10000
VIDEO_TIMEOUT_MS=1200000
# ffmpeg is needed only for the Final Video node. Leave empty to use ffmpeg from PATH.
FFMPEG_PATH=
